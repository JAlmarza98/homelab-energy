# Example systemd unit for DRuggeri/nut_exporter on RP-node2 (see
# CLAUDE.md topology). This is a third-party tool, not part of NUT
# itself — download the linux-arm64 binary from its GitHub releases
# (github.com/DRuggeri/nut_exporter) to /usr/local/bin/nut_exporter.
# Install this unit at /etc/systemd/system/nut_exporter.service, then:
#   systemctl daemon-reload && systemctl enable --now nut_exporter
#
# Exposes standard NUT/UPS metrics (ups.status, battery.charge, etc.) at
# http://<host>:9199/ups_metrics for Prometheus to scrape — NOT /metrics,
# which this exporter reserves for its own process metrics (confirmed
# via its own --help; --web.listen-address has no env var equivalent,
# unlike --nut.server). See templates/prometheus.yml.example's
# metrics_path for the matching scrape config.
#
# homelab-energy's own metrics (lib/metrics.sh) are separate, written
# via node_exporter's textfile collector instead — see
# templates/node_exporter_textfile.example.
#
# --nut.vars_enable replaces (not appends to) the built-in default list,
# so it's spelled out in full here with battery.runtime added (confirmed
# present via `upsc apc@localhost`, needed for a NUT Grafana dashboard's
# Runtime panel). ups.realpower was deliberately left out: this UPS only
# reports ups.realpower.nominal (its fixed rated wattage), not a live
# value — Back-UPS-line APC units typically don't meter real-time power
# draw, so a Power panel bound to ups.realpower stays empty regardless.

[Unit]
Description=NUT exporter for Prometheus (DRuggeri/nut_exporter)
After=network.target nut-server.service

[Service]
Environment=NUT_EXPORTER_SERVER=localhost
ExecStart=/usr/local/bin/nut_exporter --web.listen-address=:9199 --nut.vars_enable="battery.charge,battery.voltage,battery.voltage.nominal,battery.runtime,input.voltage,input.voltage.nominal,ups.load,ups.status"
Restart=on-failure
User=nut_exporter
DynamicUser=yes

[Install]
WantedBy=multi-user.target
