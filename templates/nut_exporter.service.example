# Example systemd unit for nut_exporter on RP-node2 (see CLAUDE.md topology).
# Install at /etc/systemd/system/nut_exporter.service, adjust the binary
# path and NUT_EXPORTER_SERVER, then:
#   systemctl daemon-reload && systemctl enable --now nut_exporter
#
# Exposes standard NUT/UPS metrics (ups.status, battery.charge, etc.) on
# :9199 for Prometheus to scrape. homelab-energy's own metrics (lib/metrics.sh)
# are separate, written via node_exporter's textfile collector instead —
# see templates/node_exporter_textfile.example.

[Unit]
Description=NUT exporter for Prometheus
After=network.target nut-server.service

[Service]
Environment=NUT_EXPORTER_SERVER=localhost
Environment=NUT_EXPORTER_LISTEN_ADDRESS=:9199
ExecStart=/usr/local/bin/nut_exporter
Restart=on-failure
User=nut_exporter
DynamicUser=yes

[Install]
WantedBy=multi-user.target
