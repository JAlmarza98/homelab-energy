# Example Prometheus + Grafana stack for RP-node1 (see CLAUDE.md topology).
# Copy to docker-compose.yml, put prometheus.yml.example next to it (as
# prometheus.yml, with real targets), and `docker compose up -d`.

services:
  prometheus:
    image: prom/prometheus:latest
    restart: unless-stopped
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus-data:/prometheus
    ports:
      - "9090:9090"

  grafana:
    image: grafana/grafana:latest
    restart: unless-stopped
    volumes:
      - grafana-data:/var/lib/grafana
    ports:
      - "3000:3000"
    depends_on:
      - prometheus

volumes:
  prometheus-data:
  grafana-data:
